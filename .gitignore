# ---------------------------------------------
# Java compiled output
# ---------------------------------------------
*.class
bin/
out/
build/
target/

# ---------------------------------------------
# Log files
# ---------------------------------------------
*.log
logs/

# ---------------------------------------------
# Eclipse IDE
# (.project and .classpath ARE committed so the
#  project can be imported directly into Eclipse)
# ---------------------------------------------
.settings/
.metadata/
.recommenders/
.apt_generated/
.factorypath
*.launch
*.tmp
*.bak
*.swp
*~.nib

# Other IDEs
.idea/
*.iml
.vscode/
nbproject/
.classpath.bak

# ---------------------------------------------
# Package files (keep the JDBC driver in /lib)
# ---------------------------------------------
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
*.jar
!lib/*.jar

# BlueJ / J2ME
*.ctxt
.mtj.tmp/

# JVM crash logs
hs_err_pid*
replay_pid*

# ---------------------------------------------
# Local configuration / secrets
# (db.properties holds the MySQL password)
# ---------------------------------------------
config/db.properties
config/*.local.properties
*.env
.env

# ---------------------------------------------
# Working documents - kept local only
# ---------------------------------------------
docs/
notes/
*.docx
*.pdf
~$*.docx
~$*.pdf

# ---------------------------------------------
# AI / assistant tooling - never pushed
# ---------------------------------------------
.claude/
CLAUDE.md
.claude.json
.claude-*/
.anthropic/
.cursor/
.cursorrules
.cursorignore
.aider*
.aiderignore
.continue/
.codeium/
.windsurf/
.github/copilot-instructions.md
.copilot/
.gpt/
.chatgpt/
.ai/
ai-notes/
prompts/
*.prompt
*.prompt.md
.specstory/
.history/

# ---------------------------------------------
# OS files
# ---------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
